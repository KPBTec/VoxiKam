#!KAMAILIO
# =============================================================================
# VoxiKam SBC — kamailio.cfg
# Generado por install.sh — NO editar manualmente en fresh install
# En upgrade, el archivo existente se conserva (ver install.sh PASO 8)
#
# Dual-NIC:
#   LAN  {{ private_ip }}:5060  ←→  Asterisk/ViciBox (Grupo 1 dispatcher)
#   WAN  {{ public_ip }}:5060   ←→  Carriers          (Grupo = carrier_groups.id, ver htable "techmap")
#
# Flujo saliente:
#   Asterisk → INVITE sip:{techprefix}{numero}@sbc
#   → lookup en el htable "techmap" (techprefix → grupo:cid:alg, ver más
#     abajo y scripts/gen_dispatcher.py) quita el techprefix + asigna $var(grp)
#   → dispatcher selecciona carrier del grupo + aplica prefix= si corresponde
#
# Flujo entrante:
#   Carrier → INVITE → Asterisk (round-robin / failover, Grupo 1)
#
# Operación en caliente (sin reiniciar):
#   kamcmd dispatcher.reload              # recargar dispatcher.list (destinos)
#   kamcmd htable.reload techmap          # recargar techprefix→grupo (gen_dispatcher.py lo dispara solo)
#   kamcmd pv.shvSet carrier_alg int 4   # 4=round-robin, 8=prioridad (default global)
#   kamcmd pv.shvSet carrier_failover int 0   # apagar failover
#   # 11=reparto por % — es per-GRUPO (carrier_groups.algorithm), viaja
#   # dentro del valor del htable "techmap" — ver route[OUTBOUND_TO_CARRIER]
#   # ($var(alg)) y gen_dispatcher.py.
#   kamcmd dispatcher.set_state dx 101 sip:IP:5060  # deshabilitar carrier
#   kamcmd dispatcher.set_state ap 101 sip:IP:5060  # reactivar carrier
#
# Por qué NO es un #!include_file de archivo generado (como antes): esa
# directiva se resuelve UNA sola vez, al compilar el script en el arranque
# de Kamailio — un cliente/prefijo/grupo nuevo quedaba routeando con la
# lógica vieja hasta reiniciar el proceso a mano, aunque el archivo ya
# estuviera regenerado en disco (bug real encontrado en producción,
# vd1sbc2). El htable "techmap" (con dbmode=1, respaldado en
# techprefix_map) SÍ soporta recarga en caliente real vía `htable.reload`
# — validado contra Kamailio 5.6.3 real en Docker: altas, bajas y cambios
# de valor se reflejan sin restart. La lógica de acá abajo (el lookup en
# sí) es fija — nunca cambia por cliente, solo cambian los DATOS del htable.
# =============================================================================

####### Parámetros globales #######
debug=2
log_stderror=no
log_facility=LOG_LOCAL0
fork=yes
children={{ kamailio_children }}
# async_ms_sleep() (route[CPS_GATE], pacing de CPS) necesita ESTE parámetro
# de core, no alcanza con modparam("async","workers",N) — ese es del
# módulo async (async_route/timers), el core usa el suyo propio para
# async_task_push(). Sin esto: "async task pushed, but no async workers -
# ignoring" y la llamada queda colgada para siempre (probado real, Docker/
# Kamailio 5.6.3 — un burst de CPS por encima del límite se quedaba sin
# responder nunca, ni 200 ni 503).
async_workers=4
disable_tcp=yes
auto_aliases=no
open_files_limit=65536
mlock_pages=yes
tos=0x18

listen=udp:{{ private_ip }}:5060 advertise {{ private_ip }}:5060
listen=udp:{{ public_ip }}:5060  advertise {{ public_ip }}:5060

####### Módulos #######
mpath="/usr/lib/x86_64-linux-gnu/kamailio/modules/"
loadmodule "tm.so"
loadmodule "tmx.so"
loadmodule "sl.so"
loadmodule "rr.so"
loadmodule "pv.so"
loadmodule "maxfwd.so"
loadmodule "textops.so"
loadmodule "siputils.so"
loadmodule "xlog.so"
loadmodule "ctl.so"
loadmodule "rtpengine.so"
loadmodule "dispatcher.so"
loadmodule "db_mysql.so"
loadmodule "sqlops.so"
loadmodule "dialog.so"
loadmodule "siptrace.so"
loadmodule "htable.so"
loadmodule "async.so"

####### Parámetros de módulos #######
modparam("rr", "enable_full_lr", 1)
modparam("rr", "append_fromtag", 1)

# ctl (kamcmd): defaults (32KB/8KB) no alcanzan para "dlg.briefing" con
# muchos diálogos activos a la vez — kamcmd responde "ERROR: reply too big"
# en vez del dump, y ese texto de error pasaba sin avisar por el parser de
# cron_dlg_stats.py, guardando "0 llamadas" como si fuera real (v2.24.15).
# binrpc_max_body_size / binrpc_struct_max_body_size están en KB; binrpc_buffer_size en bytes.
# Valores con margen amplio a propósito — el costo en RAM (~32MB) es
# insignificante comparado con la memoria real de Kamailio (autotune.sh),
# y da lugar para que el tráfico siga creciendo sin tener que volver a tocar esto.
modparam("ctl", "binrpc_max_body_size", 16384)
modparam("ctl", "binrpc_struct_max_body_size", 16384)
modparam("ctl", "binrpc_buffer_size", 16384)

# fr_timer: 3s sin 100 Trying → 408 → dispara failover al siguiente carrier
# fr_inv_timer: tras el 1xx espera hasta 120s la respuesta final
modparam("tm", "fr_timer", 3000)
modparam("tm", "fr_inv_timer", 120000)

modparam("rtpengine", "rtpengine_sock", "udp:127.0.0.1:2223")

# Variables de control en caliente (kamcmd pv.shvSet <var> int <val>)
modparam("pv", "shvset", "carrier_alg=i:8")       # 8=prioridad+failover, 4=round-robin
modparam("pv", "shvset", "carrier_failover=i:1")  # 1=ON, 0=OFF
modparam("pv", "shvset", "asterisk_alg=i:4")      # 4=round-robin entre ViciBox
modparam("pv", "shvset", "asterisk_failover=i:1")

# Dispatcher: health-check via OPTIONS cada 10s
# El atributo socket= en dispatcher.list controla por qué NIC sale cada ping
modparam("dispatcher", "list_file", "/etc/kamailio/dispatcher.list")
modparam("dispatcher", "flags", 2)                # habilitar failover XAVP
modparam("dispatcher", "xavp_dst", "_dsdst_")
modparam("dispatcher", "xavp_ctx", "_dsctx_")
modparam("dispatcher", "ds_ping_method", "OPTIONS")
modparam("dispatcher", "ds_ping_interval", 10)
modparam("dispatcher", "ds_probing_threshold", 2)
modparam("dispatcher", "ds_inactive_threshold", 3)
modparam("dispatcher", "ds_ping_reply_codes", "class=2;code=401;code=403;code=404")
modparam("dispatcher", "ds_probing_mode", 1)
modparam("dispatcher", "ds_ping_from", "sip:sbc@{{ public_ip }}")
modparam("dispatcher", "ds_ping_latency_stats", 1)
modparam("dispatcher", "ds_latency_estimator_alpha", 900)

# CPS pacing por carrier — ver route[CPS_GATE] más abajo. Un carrier con
# cps= en dispatcher.list (gen_dispatcher.py, desde carriers.cps_limit)
# nunca recibe más INVITEs/seg que su límite — el excedente ESPERA
# (reintentos cortos vía async_ms_sleep) y se reenvía apenas hay lugar, en
# vez de rechazarse. Sin esto (cps_limit NULL), cero cambio de comportamiento.
#
# DISEÑO REAL (no el original): la primera versión intentaba encolar con
# t_suspend() + una cola FIFO en htable, drenada por un rtimer que llamaba
# t_continue() con el índice/label guardados. Probado contra un Kamailio
# 5.6.3 real (Docker/Debian 12): t_continue() EXIGE que sus 2 primeros
# parámetros sean constantes literales en el config — no acepta un valor
# leído en runtime desde un $var()/$avp(), así que es IMPOSIBLE reanudar
# una transacción elegida dinámicamente desde un route de rtimer. El
# módulo async sí soporta esto (async_ms_sleep() con un valor runtime SÍ
# parseó bien, confirmado igual con el Kamailio real) — reemplaza todo el
# mecanismo de cola+drain por un reintento propio: cada llamada se
# suspende a sí misma con async_ms_sleep(100) y vuelve a entrar a
# route[CPS_GATE], sin necesitar guardar ni reanudar la transacción de
# otra — el módulo async ya se encarga de eso internamente.
#
# cps: contador por (carrier_id, segundo actual) — autoexpire=2 limpia
# solo los segundos viejos, nunca hace falta resetear a mano.
modparam("htable", "htable", "cps=>size=8;autoexpire=2;")

# techmap: techprefix → "grupo:customer_id:algoritmo", respaldado en MySQL
# (techprefix_map, ver db/schema.sql) — dbmode=1 = auto-carga al arrancar Y
# soporta `kamcmd htable.reload techmap` en caliente (ver el comentario
# grande sobre esto más arriba). gen_dispatcher.py es el único que escribe
# esta tabla — reemplaza TODO su contenido en cada corrida y dispara el
# reload. size=10 = hasta 1024 slots, de sobra para la cantidad real de
# prefijos técnicos de esta plataforma.
modparam("htable", "db_url", "mysql://{{ db_user }}:{{ db_pass }}@127.0.0.1:{{ db_port }}/{{ db_name }}")
modparam("htable", "htable", "techmap=>size=10;dbtable=techprefix_map;dbmode=1;")

# balance_block: LISTA DE BLOQUEO (no mapeo) de techprefix con saldo prepago
# agotado, respaldada en MySQL (balance_block_map, ver db/schema.sql) —
# mismo dbmode=1 que techmap. scripts/sync_balance_block.py es el único que
# escribe esta tabla (cron cada 1 min) y dispara `kamcmd htable.reload
# balance_block`. Ausencia de la clave = permitido — postpago nunca aparece
# acá. No corta llamadas en curso, solo evita originar una nueva.
modparam("htable", "htable", "balance_block=>size=8;dbtable=balance_block_map;dbmode=1;")

# workers: procesos dedicados que ejecutan las reanudaciones de
# async_ms_sleep() — separados de los workers normales de SIP, así que un
# reintento de CPS nunca bloquea tráfico de otro cliente/carrier.
# ms_timer: resolución del timer interno en ms (10 alcanza de sobra para
# reintentos de 100ms).
modparam("async", "workers", 2)
modparam("async", "ms_timer", 10)

# SIP trace → mini-Homer (hep_listener.py escucha en :9060)
#
# trace_mode (no trace_flag/setflag/sip_trace() disperso por el script) —
# INVESTIGADO A FONDO (fuente real de siptrace.c) tras un bug real: con el
# modo anterior (trace_flag + sip_trace() llamado a mano en 4 puntos), el
# BYE/INVITE relayed solo se veía en el ladder saliendo del SBC hacia el
# destino, nunca el tramo de llegada real (origen→SBC) — porque ese modo
# engancha callbacks de TM (trace_transaction: REQUEST_SENT, RESPONSE_IN,
# RESPONSE_SENT, ACK_NEG_IN, E2ECANCEL_IN) y NO existe un callback de
# "request recibido", solo de "request enviado" — por diseño del módulo,
# no por un error de dónde se llamaba sip_trace() en este archivo. Las
# respuestas (100/180/200) sí se veían completas porque SÍ tienen callback
# de entrada y de salida.
# trace_mode engancha en cambio los eventos de red del núcleo
# (SREV_NET_DATA_RECV/SENT, siptrace_net_data_recv/send en siptrace.c) —
# un nivel MÁS ABAJO que el de transacción SIP: cada paquete real que
# Kamailio recibe o manda, en los dos sentidos, sin necesidad de ningún
# sip_trace() en el script. Documentado explícitamente: "if [sip_trace() o
# el flag] is done, then the storing and mirroring is duplicated" — por
# eso NO hay que dejar los setflag(28)/sip_trace() de antes, hay que
# sacarlos (ver más abajo, ya no están).
modparam("siptrace", "trace_on", 1)
modparam("siptrace", "trace_mode", 1)
modparam("siptrace", "duplicate_uri", "sip:127.0.0.1:9060")
modparam("siptrace", "hep_mode_on", 1)
modparam("siptrace", "hep_version", 3)
modparam("siptrace", "hep_capture_id", 1)
modparam("siptrace", "trace_to_database", 0)

# CDR tracking via dialog + sqlops
modparam("sqlops", "sqlcon", "kb=>mysql://{{ db_user }}:{{ db_pass }}@127.0.0.1:{{ db_port }}/{{ db_name }}")
modparam("dialog", "db_url", "mysql://{{ db_user }}:{{ db_pass }}@127.0.0.1:{{ db_port }}/{{ db_name }}")
modparam("dialog", "db_mode", 0)
modparam("dialog", "enable_stats", 1)
modparam("dialog", "hash_size", 4096)

####### Ruta principal #######

request_route {
    if (!mf_process_maxfwd_header("10")) {
        sl_send_reply("483", "Too Many Hops");
        exit;
    }

    # OPTIONS keepalive (sin diálogo) → responder directo
    if (is_method("OPTIONS") && !has_totag()) {
        sl_send_reply("200", "Keepalive");
        exit;
    }

    # Trunk SBC: sin registro
    if (is_method("REGISTER")) {
        sl_send_reply("403", "Trunk SBC - No Registration Allowed");
        exit;
    }

    # Ocultar identidad interna
    remove_hf("User-Agent");
    append_hf("User-Agent: VoxiKam-SBC\r\n");

    # Peticiones dentro de diálogo (BYE, reINVITE, UPDATE, ACK 2xx…)
    if (has_totag()) {
        if (loose_route()) {
            if ((is_method("INVITE") || is_method("UPDATE")) && has_body("application/sdp")) {
                rtpengine_manage();
            }
            if (is_method("BYE")) {
                # BUG REAL encontrado y reproducido en un entorno aislado
                # (Kamailio 6.0.1 + rtpengine + mariadb, fuera de producción):
                # t_check_trans() acá daba FALSE en el PRIMER Y ÚNICO BYE de
                # la llamada — no en una retransmisión real, nunca hubo
                # ninguna. Secuencia confirmada con trazas: loose_route()
                # dispara el matching del módulo dialog, que EN ESE MOMENTO
                # ya deja tocada la capa de transacciones (TM) — así que
                # cuando el script recién acá pregunta con t_check_trans(),
                # Kamailio ve la transacción "ya existente" y devuelve false,
                # aunque sea la primera vez que este BYE llega. Resultado:
                # exit; sin rtpengine_delete(), sin UPDATE de hangup_cause, y
                # sin relay/reply de ningún tipo — el otro lado de la llamada
                # nunca se entera del corte y la sigue facturando hasta que
                # algo externo (ej. el refresh de Session-Expires) la
                # destapa, mucho más tarde y con la llamada ya "colgada" del
                # lado de quien nunca recibió el BYE.
                #
                # Reemplazado por un marcador propio en $dlg_var — vive en
                # memoria compartida del diálogo (no en la transacción), así
                # que sí sobrevive correctamente entre reintentos reales del
                # mismo BYE (retransmisión UDP) sin depender del estado de TM
                # que causaba el falso positivo de arriba.
                if ($dlg_var(bye_seen) == "1") { exit; }
                $dlg_var(bye_seen) = "1";

                # Liberar la sesión de RTPEngine AHORA — sin esto, queda huérfana
                # hasta que expira sola por su propio timeout interno (hasta
                # 3600s para streams silenciosos), acumulando sesiones zombie
                # (medido en producción: 1158 sesiones RTPEngine vs 149
                # diálogos reales en Kamailio en el mismo momento).
                rtpengine_delete();
                # Comparar $si (IP origen del BYE) con $dlg_var(src_ip) (IP del INVITE inicial).
                # Si coinciden → el cliente/Asterisk cortó. Si no → el carrier cortó.
                # $Ri (interfaz de recepción) no sirve porque Asterisk usa WAN (.33→.41).
                if ($si == $dlg_var(src_ip)) {
                    $dlg_var(hangup_by) = "CLIENTE";
                    sql_query("kb",
                        "UPDATE cdrs SET hangup_cause='CLIENTE' WHERE call_id='$(ci{s.escape.common})'",
                        "r");
                    xlog("L_INFO", "[$(ci{s.select,0,@})] BYE from=$fU to=$tU — cortó CLIENTE ($si)\n");
                } else {
                    $dlg_var(hangup_by) = "CARRIER";
                    sql_query("kb",
                        "UPDATE cdrs SET hangup_cause='CARRIER' WHERE call_id='$(ci{s.escape.common})'",
                        "r");
                    xlog("L_INFO", "[$(ci{s.select,0,@})] BYE from=$fU to=$tU — cortó CARRIER ($si)\n");
                }
            }
            route(RELAY);
            exit;
        } else {
            if (is_method("ACK")) {
                if (t_check_trans()) { route(RELAY); }
                exit;
            }
            sl_send_reply("404", "Not here");
            exit;
        }
    }

    if (is_method("CANCEL")) {
        # Llamada cancelada antes de ser contestada — si ya hubo early media
        # (rtpengine_manage() en el INVITE inicial), liberar esa sesión
        # también, mismo motivo que en BYE.
        rtpengine_delete();
        if (t_check_trans()) { route(RELAY); }
        exit;
    }

    if (!is_method("INVITE")) {
        sl_send_reply("405", "Method Not Allowed");
        exit;
    }

    record_route();

    # Detectar dirección por techprefix: si el R-URI tiene un techprefix conocido
    # → llamada saliente (cliente). Si no coincide → llamada entrante (carrier).
    # Funciona igual para clientes LAN y WAN. TODOS los techprefix de esta
    # plataforma son SIEMPRE 4 dígitos (invariante ya usado en el resto de
    # la tooling, ej. gen_dispatcher.py/cron_dlg_stats.py) — un solo lookup
    # fijo, sin loop de largos variables.
    $var(grp) = 0;
    $var(alg) = 0;
    $var(techprefix) = $(rU{s.substr,0,4});
    $var(techentry) = $sht(techmap=>$var(techprefix));
    if ($var(techentry) != $null) {
        $rU = $(rU{s.substr,4,0});
        $var(grp) = $(var(techentry){s.select,0,:});
        $var(cid) = $(var(techentry){s.select,1,:});
        # campo alg vacío = grupo 'priority', sin override — $var(alg) se
        # queda en 0 (cae a $shv(carrier_alg), ver OUTBOUND_TO_CARRIER).
        $var(algraw) = $(var(techentry){s.select,2,:});
        if ($var(algraw) != "") {
            $var(alg) = $var(algraw);
        }
        $dlg_var(techprefix) = $var(techprefix);

        # Cliente prepago con saldo agotado — bloquea SOLO llamadas nuevas,
        # nunca corta una en curso (ver scripts/sync_balance_block.py y el
        # comentario en db/schema.sql). Va acá adentro a propósito: solo
        # aplica a llamadas que ya matchearon un techprefix de cliente real,
        # nunca a tráfico entrante de carrier.
        if ($sht(balance_block=>$var(techprefix)) != $null) {
            sl_send_reply("402", "Payment Required");
            exit;
        }
    }
    if ($var(grp) != 0) {
        route(OUTBOUND_TO_CARRIER);
    } else {
        route(INBOUND_TO_ASTERISK);
    }
    exit;
}

####### SALIENTE: Asterisk → Carrier #######

route[OUTBOUND_TO_CARRIER] {
    if (has_body("application/sdp")) {
        # Si Asterisk conectó por LAN (priv) → asignar priv para su RTP
        # Si Asterisk conectó por WAN (pub)  → asignar pub para su RTP (no tiene ruta a la LAN)
        if ($Ri == "{{ private_ip }}") {
            rtpengine_manage("direction=priv direction=pub replace-origin replace-session-connection");
        } else {
            rtpengine_manage("direction=pub direction=pub replace-origin replace-session-connection");
        }
    }

    # $var(grp) y $rU ya vienen listos desde request_route (include ya ejecutado).
    # orig_rU/grp se copian a AVP (no $var) porque CPS_GATE puede suspenderse
    # a sí mismo (async_ms_sleep) para reintentar — $var() NO sobrevive esa
    # suspensión (es local a esta ejecución del script), $avp() sí, porque
    # queda atado al mensaje/transacción. route[CARRIER_SEND] de abajo solo
    # lee de $avp()/$dlg_var() por eso.
    $avp(orig_rU) = $rU;
    $avp(grp) = $var(grp);
    # customer_id REAL, viene del htable "techmap" junto con $var(grp) (ver
    # gen_dispatcher.py) — $var(grp) ES el id real de carrier_groups (no un
    # número derivado de customer_id), así que nunca hay que calcular cid a
    # partir de grp.
    $avp(cid) = $var(cid);

    # alg=11 (reparto por %) / alg=4 (round robin) vienen del algoritmo del
    # grupo (carrier_groups.algorithm), empaquetados en el htable "techmap"
    # junto con $var(grp) (ver gen_dispatcher.py). Si el grupo es
    # 'priority' viene vacío → $var(alg) se quedó en 0 (default de arriba)
    # → usar el algoritmo global de siempre. No hace falta copiar a avp: se
    # consume acá mismo, antes de cualquier t_suspend() posible de CPS_GATE.
    if ($var(alg) == 0) {
        $var(alg) = $shv(carrier_alg);
    }

    if (!ds_select_dst($var(grp), $var(alg))) {
        xlog("L_ERR", "OUTBOUND: sin carriers activos en grupo $var(grp) para $fU→$rU\n");
        rtpengine_delete();
        # t_reply() exige una transacción ya creada (t_newtran()/t_relay()) —
        # acá todavía no existe ninguna (ds_select_dst() falló antes de
        # llegar a CARRIER_SEND/RELAY), por eso tm tiraba "cannot send a
        # t_reply to a message for which no T-state has been established"
        # y el llamante se quedaba sin ninguna respuesta (ni 503 ni nada) —
        # confirmado en producción real, no en teoría.
        sl_send_reply("503", "No Carriers Available");
        exit;
    }

    route(SET_CARRIER_DST);

    # cps= en dispatcher.list (ver gen_dispatcher.py, desde carriers.cps_limit)
    # — si el carrier elegido tiene límite, CPS_GATE decide entre relayar ya
    # o esperar. Sin cps= (carrier sin límite), $avp(cps_limit) queda vacío
    # y esto no hace nada — cero cambio de comportamiento para ese carrier.
    # CPS_GATE es dueño de TODO el desenlace en este caso (relaya vía
    # CARRIER_SEND o responde 503 vía CPS_TIMEOUT, siempre con exit adentro)
    # — nunca vuelve el control acá abajo.
    if ($avp(cps_limit) != $null && $avp(cps_limit) > 0) {
        route(CPS_GATE);
        exit;
    }

    route(CARRIER_SEND);
}

# Arma el diálogo/CDR-tracking y relaya — comparte código entre el camino
# normal (arriba) y el reintentado desde CPS_GATE tras un async_ms_sleep.
# Todo lo que usa viene de $avp()/$dlg_var(), nunca de $var() — ver el
# comentario en OUTBOUND_TO_CARRIER sobre qué sobrevive esa suspensión.
route[CARRIER_SEND] {
    $dlg_var(customer_id) = $avp(cid);
    $dlg_var(src_ip)      = $si;
    $dlg_var(src_number)  = $fU;
    $dlg_var(dst_number)  = $avp(orig_rU);
    $dlg_var(start_ts)    = $TS;
    dlg_manage();

    if ($shv(carrier_failover) == 1) {
        t_on_failure("CARRIER_FAILOVER");
    }
    route(RELAY);
}

# Prepara el envío al carrier seleccionado.
# Se llama en el intento inicial y en cada salto de failover.
# Siempre parte de orig_rU para que el prefix= no se encadene.
route[SET_CARRIER_DST] {
    $fs = "udp:{{ public_ip }}:5060";

    $rU = $avp(orig_rU);
    $var(pfx) = $(xavp(_dsdst_=>attrs){param.value,prefix});
    if ($var(pfx) != "") {
        $rU = $var(pfx) + $rU;
    }

    $rd = $(du{uri.host});
    $rp = $(du{uri.port});

    # Leer carrier_id (+ límite de CPS si tiene) de los atributos del
    # dispatcher.list y actualizar dlg_var (en failover se llama de nuevo
    # → queda el carrier real). carrier_id y cps_limit van también a AVP
    # — ver por qué en OUTBOUND_TO_CARRIER (tienen que sobrevivir el
    # async_ms_sleep() de un reintento en CPS_GATE).
    $var(carrier_id) = $(xavp(_dsdst_=>attrs){param.value,carid});
    $dlg_var(carrier_id) = $var(carrier_id);
    $avp(carrier_id)     = $var(carrier_id);
    $dlg_var(dst_raw)    = $rU;
    $avp(cps_limit) = $(xavp(_dsdst_=>attrs){param.value,cps});

    xlog("L_INFO", "[$(ci{s.select,0,@})] OUTBOUND: src=$si from=$fU orig=$avp(orig_rU) rUri=$rU carrier=$du grp=$var(grp)\n");
}

# ── CPS pacing — ver comentario largo en modparam htable/async más arriba ──
#
# CPS_GATE: llamado desde OUTBOUND_TO_CARRIER solo cuando el carrier
# elegido tiene cps= seteado. Camino rápido si hay lugar en el contador del
# segundo actual. Si no, se reintenta a sí mismo: async_ms_sleep(100) +
# route(CPS_GATE) de nuevo — el módulo async reanuda ESTA llamada
# automáticamente (a diferencia de t_continue(), no hace falta guardar ni
# pasarle ningún id a mano, y SÍ acepta el delay como valor runtime — los
# dos, confirmado con kamailio -c real contra Kamailio 5.6.3). Sigue así
# hasta que hay lugar o se cumple {{ cps_max_wait_ms }}ms, momento en que
# se da por vencido (CPS_TIMEOUT, responde 503) en vez de esperar para
# siempre — un carrier sostenidamente saturado tiene que fallar rápido, no
# quedarse reintentando indefinidamente.
route[CPS_GATE] {
    $var(seckey) = "cps::" + $avp(carrier_id) + "::" + $TS;

    # $shtinc() — probado contra Kamailio 5.6.3 real (Docker/Debian 12) con
    # un .cfg mínimo aislado: SIEMPRE devuelve 0 y nunca persiste nada en
    # la htable, aunque la doc/fuente del módulo dice que debería
    # incrementar. Reemplazado por lectura+escritura manual.
    #
    # sht_lock()/sht_unlock() — probado igual de real: NO aceptan un
    # argumento con $var() (ni siquiera una referencia simple sin
    # concatenar, "parameter 1 is not constant") — a diferencia de lo que
    # dice la fuente del módulo, en este binario exigen un string literal
    # 100% fijo. Por eso acá el lock es GLOBAL para toda la tabla "cps"
    # (no por carrier/segundo) — sin el lock, dos workers concurrentes
    # podrían leer el mismo contador viejo y admitir de más justo en el
    # límite. La sección crítica es mínima (2 operaciones de pvar), así
    # que un lock global no debería notarse en la práctica.
    sht_lock("cps=>lock");
    $var(cnt) = $sht(cps=>$var(seckey));
    if ($var(cnt) == $null) { $var(cnt) = 0; }

    if ($var(cnt) < $avp(cps_limit)) {
        $sht(cps=>$var(seckey)) = $var(cnt) + 1;
        sht_unlock("cps=>lock");
        route(CARRIER_SEND);
        exit;
    }
    sht_unlock("cps=>lock");

    # $avp(cps_waited) sobrevive el async_ms_sleep (a diferencia de
    # $var()) — arranca en 0 la primera vez que este INVITE pasa por acá.
    if ($avp(cps_waited) == $null) {
        $avp(cps_waited) = 0;
    }
    if ($avp(cps_waited) >= {{ cps_max_wait_ms }}) {
        route(CPS_TIMEOUT);
        exit;
    }

    $avp(cps_waited) = $avp(cps_waited) + 100;
    xlog("L_INFO", "CPS_GATE: carrier $avp(carrier_id) al límite ($avp(cps_limit)/s) — esperando (llevo $avp(cps_waited)ms)\n");
    async_ms_sleep("100");
    route(CPS_GATE);
    exit;
}

route[CPS_TIMEOUT] {
    xlog("L_WARN", "CPS_GATE: carrier $avp(carrier_id) — {{ cps_max_wait_ms }}ms sin lugar, 503\n");
    rtpengine_delete();
    # mismo problema que en OUTBOUND_TO_CARRIER: acá tampoco hay transacción
    # creada todavía (CPS_GATE corre antes de CARRIER_SEND/RELAY) — t_reply()
    # fallaba silenciosamente, sl_send_reply() no necesita transacción.
    sl_send_reply("503", "Carrier CPS limit exceeded");
}

####### ENTRANTE: Carrier → Asterisk #######

route[INBOUND_TO_ASTERISK] {
    if (has_body("application/sdp")) {
        rtpengine_manage("direction=pub direction=priv replace-origin replace-session-connection");
    }

    if (!ds_select_dst("1", $shv(asterisk_alg))) {
        xlog("L_ERR", "INBOUND: sin Asterisk activos (grupo 1) src=$si\n");
        rtpengine_delete();
        # mismo problema: sin transacción creada todavía en este punto,
        # t_reply() fallaba (tm.c: "no T-state has been established") y el
        # carrier se quedaba sin respuesta alguna en vez de un 503 limpio.
        sl_send_reply("503", "All Asterisk Nodes Down");
        exit;
    }

    $fs = "udp:{{ private_ip }}:5060";
    $rd = $(du{uri.host});
    $rp = $(du{uri.port});

    xlog("L_INFO", "[$(ci{s.select,0,@})] INBOUND: src=$si from=$fU to=$rU → $du\n");

    if ($shv(asterisk_failover) == 1) {
        t_on_failure("ASTERISK_FAILOVER");
    }
    route(RELAY);
}

####### Relay #######

route[RELAY] {
    t_on_reply("MANAGE_REPLY");
    if (!t_relay()) {
        sl_reply_error();
    }
    exit;
}

####### Filtro de traza — trace_mode traza TODO paquete a nivel de red, sin
####### esto cada OPTIONS keepalive de dispatcher (cada 10s por carrier o
####### cliente) y cada intento de REGISTER (rechazado igual, pero antes ni
####### se trazaba) inflarían sip_traces con ruido que antes no existía #######

event_route[siptrace:msg] {
    if (is_method("OPTIONS") || is_method("REGISTER")) {
        drop();
    }
}

onreply_route[MANAGE_REPLY] {
    xlog("L_INFO", "[$(ci{s.select,0,@})] REPLY: $rs desde $si\n");
    if ($rs >= 300) { $dlg_var(last_code) = $rs; }
    if (has_body("application/sdp")) {
        rtpengine_manage();
    }
}

####### Failover carriers (saliente) #######
# Solo reintenta en 5xx o 408 — señal de problema del carrier/red. NO
# reintenta 4xx legítimos (404, 486, 487…): esas son respuestas finales
# sobre el NÚMERO marcado, no sobre el carrier — reintentar con otro
# carrier no cambia que el número esté ocupado o no exista.

failure_route[CARRIER_FAILOVER] {
    if (t_is_canceled()) { exit; }
    # $avp(grp), no $var(grp) — un failure_route corre en una ejecución de
    # script separada de la original, $var() no sobrevive ese salto (mismo
    # motivo que $avp(orig_rU)/$avp(cid) más arriba); usar $var(grp) acá
    # logueaba siempre "grupo 0" en vez del grupo real — confirmado en
    # producción (vd1sbc2).

    if (t_check_status("5[0-9][0-9]") || t_check_status("408")) {
        # "FAILOVER" en el log solo si REALMENTE va a intentar otro carrier —
        # antes se logueaba esa palabra siempre, incondicionalmente, incluso
        # cuando no había ningún otro carrier al cual saltar (con 1 solo
        # carrier por grupo, daba a entender un reintento que nunca pasaba).
        # Primero reportamos el hecho (carrier respondió con este código),
        # sin mencionar failover — recién si ds_next_dst() confirma que SÍ
        # hay otro destino, ahí sí se llama failover de verdad.
        if (ds_next_dst()) {
            xlog("L_WARN", "[$(ci{s.select,0,@})] FAILOVER carrier: $du falló ($T_reply_code) — reintentando con siguiente carrier del grupo $avp(grp)\n");
            route(SET_CARRIER_DST);  # actualiza dlg_var(carrier_id) al nuevo carrier
            t_on_failure("CARRIER_FAILOVER");
            route(RELAY);
            exit;
        }

        # Sin otro carrier configurado en el grupo — esto NO es un failover,
        # es simplemente el resultado de esta llamada puntual.
        xlog("L_WARN", "[$(ci{s.select,0,@})] Llamada fallida: $du respondió ($T_reply_code), grupo $avp(grp) sin carrier de respaldo\n");
        rtpengine_delete();
        t_reply("503", "Carrier Unavailable");
        exit;
    }

    # 4xx legítimo (404, 486, 487…) — no se reintenta, la llamada termina acá
    # sin pasar nunca por BYE ni CANCEL. Sin esto, la sesión de RTPEngine
    # abierta en el INVITE inicial quedaba huérfana hasta expirar sola.
    rtpengine_delete();
}

####### Failover Asterisk (entrante) #######

failure_route[ASTERISK_FAILOVER] {
    if (t_is_canceled()) { exit; }

    if (t_check_status("5[0-9][0-9]") || t_check_status("408")) {
        if (ds_next_dst()) {
            $fs = "udp:{{ private_ip }}:5060";
            $rd = $(du{uri.host});
            $rp = $(du{uri.port});
            xlog("L_WARN", "[$(ci{s.select,0,@})] FAILOVER Asterisk: → $du\n");
            t_on_failure("ASTERISK_FAILOVER");
            route(RELAY);
            exit;
        }
        rtpengine_delete();
        t_reply("503", "All Asterisk Failed");
        exit;
    }

    # 4xx legítimo — misma razón que en CARRIER_FAILOVER: la llamada termina
    # acá sin BYE/CANCEL, hay que liberar la sesión de RTPEngine explícitamente.
    rtpengine_delete();
}

####### CDR — dialog events #######

# Llamada contestada (primer 200 OK del carrier)
event_route[dialog:start] {
    $dlg_var(answer_ts) = $TS;
    sql_query("kb",
        "INSERT INTO active_calls
            (call_id, customer_id, carrier_id, src_ip, src_number, dst_number, started_at)
         VALUES
            ('$(ci{s.escape.common})',
             $dlg_var(customer_id),
             NULLIF('$dlg_var(carrier_id)', ''),
             '$(dlg_var(src_ip){s.escape.common})',
             '$(dlg_var(src_number){s.escape.common})',
             '$(dlg_var(dst_number){s.escape.common})',
             FROM_UNIXTIME($dlg_var(start_ts)))
         ON DUPLICATE KEY UPDATE started_at=started_at",
        "r");
    xlog("L_INFO", "[$(ci{s.select,0,@})] CDR-START: cust=$dlg_var(customer_id) carrier=$dlg_var(carrier_id) src=$dlg_var(src_number) dst=$dlg_var(dst_number)\n");
}

# Llamada terminada (BYE procesado)
event_route[dialog:end] {
    $var(sessiontime) = $TS - $dlg_var(start_ts);
    if ($dlg_var(answer_ts) != "") {
        $var(billsec) = $TS - $dlg_var(answer_ts);
        $var(disp)    = "ANSWERED";
    } else {
        $var(billsec) = 0;
        $var(disp)    = "NO_ANSWER";
    }

    sql_query("kb",
        "DELETE FROM active_calls WHERE call_id='$(ci{s.escape.common})'",
        "r");

    sql_query("kb",
        "INSERT INTO cdrs
            (call_id, customer_id, carrier_id, src_ip, src_number,
             dst_number, dst_number_raw, techprefix,
             start_ts, answer_ts, end_ts,
             sessiontime, billsec, disposition, hangup_cause)
         VALUES
            ('$(ci{s.escape.common})',
             $dlg_var(customer_id),
             NULLIF('$dlg_var(carrier_id)', ''),
             '$(dlg_var(src_ip){s.escape.common})',
             '$(dlg_var(src_number){s.escape.common})',
             '$(dlg_var(dst_number){s.escape.common})',
             '$(dlg_var(dst_raw){s.escape.common})',
             NULLIF('$dlg_var(techprefix)', ''),
             FROM_UNIXTIME($dlg_var(start_ts)),
             IF('$dlg_var(answer_ts)' != '', FROM_UNIXTIME($dlg_var(answer_ts)), NULL),
             NOW(3),
             $var(sessiontime), $var(billsec), '$var(disp)',
             NULLIF('$dlg_var(hangup_by)', ''))",
        "r");

    xlog("L_INFO", "[$(ci{s.select,0,@})] CDR-END: $var(disp) dur=$var(sessiontime)s bill=$var(billsec)s\n");
}

# Llamada fallida (sin answer antes de que termine)
event_route[dialog:failed] {
    # Red de seguridad — el módulo dlg puede terminar el diálogo por su propio
    # timeout interno, no solo por una respuesta SIP puntual ya cubierta en
    # failure_route. rtpengine_delete() es idempotente: si ya se llamó antes
    # para este call-id (desde failure_route), esta segunda llamada no hace nada.
    rtpengine_delete();

    # $dlg_var(last_code) solo se setea en onreply_route[MANAGE_REPLY] cuando
    # REALMENTE llega una respuesta del carrier. Si el carrier no contesta
    # nada (fr_timer agota sin ni un 100 Trying) el 408 lo genera TM
    # localmente y nunca pasa por onreply_route — last_code queda sin setear,
    # y Kamailio interpola el pv vacío como el texto literal "<null>" en el
    # SQL (sin comillas, porque acá se espera un entero) — sintaxis inválida,
    # confirmado en producción (vd1sbc2, carrier sin responder). NULLIF lo
    # mapea a NULL real en vez de romper el INSERT completo.
    sql_query("kb",
        "INSERT INTO cdrs_failed
            (call_id, customer_id, carrier_id, src_ip, src_number, dst_number, start_ts, sip_code)
         VALUES
            ('$(ci{s.escape.common})',
             $dlg_var(customer_id),
             NULLIF('$dlg_var(carrier_id)', ''),
             '$(dlg_var(src_ip){s.escape.common})',
             '$(dlg_var(src_number){s.escape.common})',
             '$(dlg_var(dst_number){s.escape.common})',
             FROM_UNIXTIME($dlg_var(start_ts)),
             NULLIF('$dlg_var(last_code)', '<null>'))",
        "r");

    xlog("L_WARN", "[$(ci{s.select,0,@})] CDR-FAILED: code=$dlg_var(last_code) cust=$dlg_var(customer_id) dst=$dlg_var(dst_number)\n");
}
