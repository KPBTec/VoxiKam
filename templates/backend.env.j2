# KPBTec VoxiKam — Backend config
# Generado por install.sh — NO editar manualmente (usar gen_configs.py para regenerar)

DATABASE_URL=mysql+aiomysql://{{ db_user }}:{{ db_pass }}@127.0.0.1:{{ db_port }}/{{ db_name }}
DATABASE_URL_SYNC=mysql+pymysql://{{ db_user }}:{{ db_pass }}@127.0.0.1:{{ db_port }}/{{ db_name }}

# sip_traces vive en ClickHouse (backend/clickhouse.py, backend/hep_listener.py,
# backend/routers/traces.py) — todo lo demás sigue en MariaDB arriba.
CLICKHOUSE_URL={{ clickhouse_url }}

JWT_SECRET={{ jwt_secret }}
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Secreto para POST /api/admin/cdrs/ingest (header X-Ingest-Secret) — ese
# endpoint no usa JWT porque su llamador (si algún día se usa) no puede
# loguearse como usuario. Sin este valor, el endpoint queda inaccesible.
CDR_INGEST_SECRET={{ cdr_ingest_secret }}

PUBLIC_IP={{ public_ip }}
PRIVATE_IP={{ private_ip }}
DOMAIN={{ domain }}
WEB_PORT={{ web_port }}

# Sistema → Infraestructura (TLS/backup manual desde el panel) necesita saber
# dónde viven los scripts — mismo valor que $INSTALL_DIR en deploy.sh.
INSTALL_DIR={{ install_dir }}

KAMAILIO_CTL_SOCKET=/var/run/kamailio/kamailio_ctl
DISPATCHER_LIST=/etc/kamailio/dispatcher.list
NFTABLES_D=/etc/nftables.d
NFTABLES_CONF=/etc/nftables.conf

INVOICES_DIR={{ install_dir }}/invoices
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://{{ domain }}:{{ web_port }},http://{{ private_ip }}:{{ web_port }},http://{{ public_ip }}:{{ web_port }}

# HEP3 receiver (mini-Homer) — mismo host que Kamailio normalmente
HEP_HOST=127.0.0.1
HEP_PORT=9060

# Alertas de balance (Alertas → Alerta consumo) — fallback si nadie configuró
# un email de notificación desde el panel (Settings → alert_notify_email)
ADMIN_EMAIL={{ admin_email or '' }}

# Resend — vacío por defecto, sin esto las
# alertas quedan sin enviar (se loguea, no rompe nada). Obtener key en
# https://resend.com — completar a mano, deploy.sh no la pide interactivamente
# porque es un servicio externo opcional, no un requisito de instalación.
RESEND_API_KEY=
ALERT_FROM_EMAIL=no-reply@kpbtec.com
